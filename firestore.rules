rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStringList(arr, maxItems) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 100));
    }

    function hasWorkspace(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        || existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    function isMember(userId) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(userId)/members/$(request.auth.uid));
    }

    function memberRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/members/$(request.auth.uid)).data.role;
    }

    function isWorkspaceViewer(userId) {
      return isOwner(userId) || (isMember(userId) && memberRole(userId) in ['viewer', 'editor']);
    }

    function isWorkspaceEditor(userId) {
      return isOwner(userId) || (isMember(userId) && memberRole(userId) == 'editor');
    }

    function authEmailLower() {
      return request.auth.token.email is string ? request.auth.token.email.lower() : '';
    }

    function isValidWorkspace(data, userId) {
      return data.keys().hasAll(['ownerId', 'wallets', 'savingsList', 'expenseCategories', 'incomeCategories', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'wallets', 'savingsList', 'expenseCategories', 'incomeCategories', 'currency', 'themeMode', 'language', 'gridOrder', 'visibleGrids', 'expenseSubCategories', 'categoryStyles', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && isValidStringList(data.wallets, 50)
        && data.wallets.size() >= 1
        && isValidStringList(data.savingsList, 50)
        && isValidStringList(data.expenseCategories, 50)
        && data.expenseCategories.size() >= 1
        && isValidStringList(data.incomeCategories, 50)
        && data.incomeCategories.size() >= 1
        && (!('currency' in data) || (data.currency is string && data.currency in ['৳', '$', '€', '£', 'SAR', '₹']))
        && (!('themeMode' in data) || (data.themeMode is string && data.themeMode in ['light', 'dark', 'system']))
        && (!('language' in data) || (data.language is string && data.language in ['en', 'bn']))
        && (!('gridOrder' in data) || isValidStringList(data.gridOrder, 10))
        && (!('visibleGrids' in data) || (data.visibleGrids is map && data.visibleGrids.keys().size() <= 10))
        && (!('expenseSubCategories' in data) || (data.expenseSubCategories is map && data.expenseSubCategories.keys().size() <= 50))
        && (!('categoryStyles' in data) || (data.categoryStyles is map && data.categoryStyles.keys().size() <= 200))
        && data.updatedAt == request.time;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'amount', 'type', 'rawDate', 'date', 'resolved', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'amount', 'type', 'category', 'subCategory', 'wallet', 'fromWallet', 'toWallet', 'charge', 'remainingBalance', 'parentId', 'parentTitle', 'isLendPay', 'note', 'date', 'rawDate', 'resolved', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (data.amount is int || data.amount is float)
        && data.type is string && data.type in ['expense', 'income', 'transfer', 'lend', 'borrow', 'partial_payment', 'correction', 'adjustment']
        && data.rawDate is string && data.rawDate.size() == 10 && data.rawDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 40
        && data.resolved is bool
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('subCategory' in data) || (data.subCategory is string && data.subCategory.size() <= 100))
        && (!('wallet' in data) || (data.wallet is string && data.wallet.size() <= 100))
        && (!('fromWallet' in data) || (data.fromWallet is string && data.fromWallet.size() <= 100))
        && (!('toWallet' in data) || (data.toWallet is string && data.toWallet.size() <= 100))
        && (!('charge' in data) || ((data.charge is int || data.charge is float) && data.charge >= 0))
        && (!('remainingBalance' in data) || ((data.remainingBalance is int || data.remainingBalance is float) && data.remainingBalance >= 0))
        && (!('parentId' in data) || isValidId(data.parentId))
        && (!('parentTitle' in data) || (data.parentTitle is string && data.parentTitle.size() <= 200))
        && (!('isLendPay' in data) || data.isLendPay is bool)
        && (!('note' in data) || (data.note is string && data.note.size() <= 2000))
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidMemo(data, userId) {
      return data.keys().hasAll(['ownerId', 'date', 'category', 'wallet', 'items', 'total', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'date', 'category', 'subCategory', 'wallet', 'note', 'items', 'total', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && (!('subCategory' in data) || (data.subCategory is string && data.subCategory.size() <= 100))
        && data.wallet is string && data.wallet.size() >= 1 && data.wallet.size() <= 100
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 200
        && data.items[0] is map
        && (data.total is int || data.total is float) && data.total >= 0
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidNote(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'content', 'date', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'content', 'date', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.content is string && data.content.size() <= 20000
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidBudgetGoal(data, userId) {
      return data.keys().hasAll(['ownerId', 'category', 'monthlyLimit', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'category', 'monthlyLimit', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && (data.monthlyLimit is int || data.monthlyLimit is float) && data.monthlyLimit > 0
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidSavingGoal(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'periodType', 'targetAmount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'account', 'periodType', 'targetAmount', 'startDate', 'endDate', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && (!('account' in data) || (data.account is string && data.account.size() <= 100))
        && data.periodType is string && data.periodType in ['monthly', 'period']
        && (data.targetAmount is int || data.targetAmount is float) && data.targetAmount > 0
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() == 10 && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('endDate' in data) || (data.endDate is string && data.endDate.size() == 10 && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidMember(data, userId, memberUid) {
      return data.keys().hasAll(['ownerUid', 'ownerEmail', 'ownerName', 'memberUid', 'memberEmail', 'memberName', 'role', 'inviteId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'ownerEmail', 'ownerName', 'memberUid', 'memberEmail', 'memberName', 'role', 'inviteId', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid == userId
        && data.ownerEmail is string && data.ownerEmail.size() <= 200
        && data.ownerName is string && data.ownerName.size() <= 200
        && data.memberUid is string && data.memberUid == memberUid
        && data.memberEmail is string && data.memberEmail.size() <= 200
        && data.memberName is string && data.memberName.size() <= 200
        && data.role is string && data.role in ['viewer', 'editor']
        && isValidId(data.inviteId)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidShareInvite(data) {
      return data.keys().hasAll(['ownerUid', 'ownerEmail', 'ownerName', 'inviteType', 'targetEmail', 'code', 'role', 'status', 'partnerUid', 'partnerEmail', 'partnerName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'ownerEmail', 'ownerName', 'inviteType', 'targetEmail', 'code', 'role', 'status', 'partnerUid', 'partnerEmail', 'partnerName', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && data.ownerEmail is string && data.ownerEmail.size() <= 200
        && data.ownerName is string && data.ownerName.size() <= 200
        && data.inviteType is string && data.inviteType in ['email', 'code']
        && data.targetEmail is string && data.targetEmail.size() <= 200
        && data.code is string && data.code.size() <= 20
        && data.role is string && data.role in ['viewer', 'editor']
        && data.status is string && data.status in ['pending', 'accepted', 'declined', 'revoked']
        && data.partnerUid is string && data.partnerUid.size() <= 128
        && data.partnerEmail is string && data.partnerEmail.size() <= 200
        && data.partnerName is string && data.partnerName.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    match /shareInvites/{inviteId} {
      allow get: if isValidId(inviteId) && isVerifiedUser() && (
        existing().ownerUid == request.auth.uid ||
        existing().partnerUid == request.auth.uid ||
        (existing().inviteType == 'code' && existing().status == 'pending') ||
        (existing().targetEmail != '' && existing().targetEmail == authEmailLower())
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.partnerUid == request.auth.uid ||
        (resource.data.targetEmail != '' && resource.data.targetEmail == authEmailLower())
      );
      allow create: if isValidId(inviteId) && isVerifiedUser() && isValidShareInvite(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().partnerUid == ''
        && incoming().createdAt == request.time
        && hasWorkspace(request.auth.uid)
        && (
          (incoming().inviteType == 'code' && incoming().code == inviteId && incoming().code.size() >= 6 && incoming().targetEmail == '') ||
          (incoming().inviteType == 'email' && incoming().targetEmail.size() >= 3 && incoming().targetEmail != authEmailLower() && incoming().code == '')
        );
      allow update: if isValidId(inviteId) && isVerifiedUser() && isValidShareInvite(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().inviteType == existing().inviteType
        && incoming().code == existing().code
        && incoming().targetEmail == existing().targetEmail
        && incoming().createdAt == existing().createdAt
        && (
          // Action 1: Owner updates role or revokes invite
          (existing().ownerUid == request.auth.uid
            && existing().status in ['pending', 'accepted']
            && incoming().status in ['pending', 'accepted', 'revoked']
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'updatedAt'])) ||
          // Action 2: Partner accepts pending email or code invite atomically with member creation
          (existing().status == 'pending'
            && existing().ownerUid != request.auth.uid
            && (existing().inviteType == 'code' || (existing().targetEmail != '' && existing().targetEmail == authEmailLower()))
            && incoming().status == 'accepted'
            && incoming().role == existing().role
            && incoming().partnerUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'partnerUid', 'partnerEmail', 'partnerName', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/users/$(existing().ownerUid)/members/$(request.auth.uid))) ||
          // Action 3: Invited email user declines pending invite
          (existing().status == 'pending'
            && existing().inviteType == 'email'
            && existing().targetEmail != ''
            && existing().targetEmail == authEmailLower()
            && incoming().status == 'declined'
            && incoming().partnerUid == ''
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          // Action 4: Partner leaves shared workspace
          (existing().status == 'accepted'
            && existing().partnerUid == request.auth.uid
            && incoming().status == 'revoked'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isValidId(inviteId) && isVerifiedUser() && existing().ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isWorkspaceViewer(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isVerifiedUser() && isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().ownerId == request.auth.uid;
      allow update: if isValidId(userId) && isVerifiedUser() && isWorkspaceEditor(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().diff(existing()).affectedKeys().hasOnly(['wallets', 'savingsList', 'expenseCategories', 'incomeCategories', 'currency', 'themeMode', 'language', 'gridOrder', 'visibleGrids', 'expenseSubCategories', 'categoryStyles', 'updatedAt']);
      allow delete: if isValidId(userId) && isVerifiedUser() && isOwner(userId);

      match /members/{memberUid} {
        allow get: if isValidId(userId) && isValidId(memberUid) && isVerifiedUser() && (isOwner(userId) || request.auth.uid == memberUid);
        allow list: if isOwner(userId) && resource.data.ownerUid == userId;
        allow create: if isValidId(userId) && isValidId(memberUid) && isVerifiedUser()
          && request.auth.uid == memberUid
          && request.auth.uid != userId
          && isValidMember(incoming(), userId, memberUid)
          && incoming().createdAt == request.time
          && hasWorkspace(userId)
          && exists(/databases/$(database)/documents/shareInvites/$(incoming().inviteId))
          && get(/databases/$(database)/documents/shareInvites/$(incoming().inviteId)).data.ownerUid == userId
          && get(/databases/$(database)/documents/shareInvites/$(incoming().inviteId)).data.status == 'pending'
          && get(/databases/$(database)/documents/shareInvites/$(incoming().inviteId)).data.role == incoming().role
          && (
            get(/databases/$(database)/documents/shareInvites/$(incoming().inviteId)).data.inviteType == 'code' ||
            (get(/databases/$(database)/documents/shareInvites/$(incoming().inviteId)).data.targetEmail != '' &&
             get(/databases/$(database)/documents/shareInvites/$(incoming().inviteId)).data.targetEmail == authEmailLower())
          )
          && getAfter(/databases/$(database)/documents/shareInvites/$(incoming().inviteId)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/shareInvites/$(incoming().inviteId)).data.partnerUid == request.auth.uid;
        allow update: if isValidId(userId) && isValidId(memberUid) && isVerifiedUser() && isOwner(userId)
          && isValidMember(incoming(), userId, memberUid)
          && incoming().ownerUid == existing().ownerUid
          && incoming().memberUid == existing().memberUid
          && incoming().inviteId == existing().inviteId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(memberUid) && isVerifiedUser() && (isOwner(userId) || request.auth.uid == memberUid);
      }

      match /transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && isWorkspaceViewer(userId);
        allow list: if isWorkspaceViewer(userId) && resource.data.ownerId == userId;
        allow create: if isValidId(userId) && isValidId(txId) && isVerifiedUser() && isWorkspaceEditor(userId)
          && incoming().createdAt == request.time
          && isValidTransaction(incoming(), userId)
          && hasWorkspace(userId);
        allow update: if isValidId(userId) && isValidId(txId) && isVerifiedUser() && isWorkspaceEditor(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'type', 'category', 'subCategory', 'wallet', 'fromWallet', 'toWallet', 'charge', 'remainingBalance', 'note', 'date', 'rawDate', 'resolved', 'updatedAt']) ||
            (existing().type in ['lend', 'borrow'] && incoming().diff(existing()).affectedKeys().hasOnly(['remainingBalance', 'resolved', 'updatedAt'])) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['wallet', 'fromWallet', 'toWallet', 'category', 'subCategory', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(txId) && isVerifiedUser() && isWorkspaceEditor(userId);
      }

      match /memos/{memoId} {
        allow get: if isValidId(userId) && isValidId(memoId) && isWorkspaceViewer(userId);
        allow list: if isWorkspaceViewer(userId) && resource.data.ownerId == userId;
        allow create: if isValidId(userId) && isValidId(memoId) && isVerifiedUser() && isWorkspaceEditor(userId)
          && incoming().createdAt == request.time
          && isValidMemo(incoming(), userId)
          && hasWorkspace(userId);
        allow update: if isValidId(userId) && isValidId(memoId) && isVerifiedUser() && isWorkspaceEditor(userId)
          && isValidMemo(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'category', 'subCategory', 'wallet', 'note', 'items', 'total', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(memoId) && isVerifiedUser() && isWorkspaceEditor(userId);
      }

      match /notes/{noteId} {
        allow get: if isValidId(userId) && isValidId(noteId) && isWorkspaceViewer(userId);
        allow list: if isWorkspaceViewer(userId) && resource.data.ownerId == userId;
        allow create: if isValidId(userId) && isValidId(noteId) && isVerifiedUser() && isWorkspaceEditor(userId)
          && incoming().createdAt == request.time
          && isValidNote(incoming(), userId)
          && hasWorkspace(userId);
        allow update: if isValidId(userId) && isValidId(noteId) && isVerifiedUser() && isWorkspaceEditor(userId)
          && isValidNote(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'date', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(noteId) && isVerifiedUser() && isWorkspaceEditor(userId);
      }

      match /budgets/{budgetId} {
        allow get: if isValidId(userId) && isValidId(budgetId) && isWorkspaceViewer(userId);
        allow list: if isWorkspaceViewer(userId) && resource.data.ownerId == userId;
        allow create: if isValidId(userId) && isValidId(budgetId) && isVerifiedUser() && isWorkspaceEditor(userId)
          && incoming().createdAt == request.time
          && isValidBudgetGoal(incoming(), userId)
          && hasWorkspace(userId);
        allow update: if isValidId(userId) && isValidId(budgetId) && isVerifiedUser() && isWorkspaceEditor(userId)
          && isValidBudgetGoal(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'monthlyLimit', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(budgetId) && isVerifiedUser() && isWorkspaceEditor(userId);
      }

      match /savingGoals/{goalId} {
        allow get: if isValidId(userId) && isValidId(goalId) && isWorkspaceViewer(userId);
        allow list: if isWorkspaceViewer(userId) && resource.data.ownerId == userId;
        allow create: if isValidId(userId) && isValidId(goalId) && isVerifiedUser() && isWorkspaceEditor(userId)
          && incoming().createdAt == request.time
          && isValidSavingGoal(incoming(), userId)
          && hasWorkspace(userId);
        allow update: if isValidId(userId) && isValidId(goalId) && isVerifiedUser() && isWorkspaceEditor(userId)
          && isValidSavingGoal(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'account', 'periodType', 'targetAmount', 'startDate', 'endDate', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(goalId) && isVerifiedUser() && isWorkspaceEditor(userId);
      }
    }
  }
}
